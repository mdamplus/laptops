<?xml version="1.0" encoding="utf-8"?>
<unattend xmlns="urn:schemas-microsoft-com:unattend"
          xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State"
          xmlns:cpi="urn:schemas-microsoft-com:cpi">

  <!-- windowsPE: idioma/region del entorno de instalacion -->
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>es-ES</InputLocale>
      <SystemLocale>es-ES</SystemLocale>
      <UILanguage>es-ES</UILanguage>
      <UserLocale>es-ES</UserLocale>
    </component>
  </settings>

  <!-- specialize: nombre de equipo, zona horaria y CopyProfile -->
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <ComputerName>*</ComputerName>
      <RegisteredOrganization>Centro Educativo</RegisteredOrganization>
      <RegisteredOwner>Arrabal AID</RegisteredOwner>
      <TimeZone>Romance Standard Time</TimeZone>
      <CopyProfile>true</CopyProfile>
    </component>
  </settings>

  <!-- oobeSystem: OOBE, crear usuarios locales -->
  <settings pass="oobeSystem">
    <!-- Idiomas en OOBE -->
    <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>es-ES</InputLocale>
      <SystemLocale>es-ES</SystemLocale>
      <UILanguage>es-ES</UILanguage>
      <UILanguageFallback>es-ES</UILanguageFallback>
      <UserLocale>es-ES</UserLocale>
    </component>

    <!-- OOBE: ocultar pantallas de cuenta online -->
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideLocalAccountScreen>false</HideLocalAccountScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>false</HideWirelessSetupInOOBE>
        <NetworkLocation>Work</NetworkLocation>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>

      <!-- Usuarios locales -->
      <UserAccounts>
        <LocalAccounts>

          <!-- AULA sin contraseña: NO incluir <Password> -->
          <LocalAccount wcm:action="add">
            <Name>Aula</Name>
            <Group>Users</Group>
            <DisplayName>Usuario Aula</DisplayName>
            <Description>Cuenta estándar para alumnos</Description>
          </LocalAccount>

          <!-- Administrador local con contraseña (cámbiala) -->
          <LocalAccount wcm:action="add">
            <Name>Administrador</Name>
            <Group>Administrators</Group>
            <DisplayName>Administrador</DisplayName>
            <Description>Cuenta de administración local</Description>
            <Password>
              <Value>Admin_2025!</Value>
              <PlainText>true</PlainText>
            </Password>
          </LocalAccount>

        </LocalAccounts>
      </UserAccounts>

      <!-- Sin autologon -->
      <AutoLogon>
        <Enabled>false</Enabled>
        <LogonCount>1</LogonCount>
        <Username></Username>
      </AutoLogon>
    </component>
  </settings>

  <!-- Referencia opcional -->
  <cpi:offlineImage cpi:source="wim://wimfile/install.wim#Windows 11" />
</unattend>
<!-- fin -->
